{
  "expo": {
    "name": "Visual Travel Guide",
    "slug": "visual-travel-guide",
    "version": "0.1.0",
    "scheme": "visual-travel-guide",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "allowBackup": false,
      "package": "com.visualtravelguide.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-font", {"android":{"fonts":[{
        "fontFamily":"SpoqaHanSans",
        "fontDefinitions":[
          {"path":"./assets/fonts/SpoqaHanSansRegular.ttf","weight":400},
          {"path":"./assets/fonts/SpoqaHanSansBold.ttf","weight":700}
        ]
      }]}}],
      [
        "expo-image-picker",
        {
          "cameraPermission": "사진을 촬영하려면 카메라 접근이 필요해요.",
          "photosPermission": "선택한 사진을 가져와요.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      ["expo-secure-store",{"configureAndroidBackup":true}]
    ]
  }
}
